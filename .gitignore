# Collaborator-provided source documents (private, local only)
data/raw/*

# Private ground truth and extraction outputs
data/ground_truth/*
!data/ground_truth/.gitkeep
data/outputs/*
!data/outputs/.gitkeep

# Python virtual environments
.venv/
venv/
env/

# Python-generated files
__pycache__/
*.py[cod]

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE and OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment files and secrets
.env
.env.*
*.pem
*.key

# Temporary files and logs
*.tmp
*.temp
*.log
